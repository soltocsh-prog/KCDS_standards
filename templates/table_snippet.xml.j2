<TABLE BorderFill="2" CellSpacing="0" ColCount="{{ col_count }}" PageBreak="Cell" RepeatHeader="true" RowCount="{{ row_count }}"><SHAPEOBJECT InstId="{{ table_id }}" Lock="false" NumberingType="Table" TextWrap="TopAndBottom" ZOrder="0"><SIZE Height="{{ 282 * row_count }}" HeightRelTo="Absolute" Protect="false" Width="42520" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Column" TreatAsChar="false" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="283" Left="283" Right="283" Top="283"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/>{% for r_idx in range(row_count) %}<ROW>{% for cell in row_cells[r_idx] %}<CELL BorderFill="2" ColAddr="{{ cell.col }}" ColSpan="{{ cell.colspan }}" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="282" Protect="false" RowAddr="{{ cell.row }}" RowSpan="{{ cell.rowspan }}" Width="{{ cell_width * cell.colspan }}"><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="12" Style="0">{% if cell.text %}<TEXT CharShape="0"><CHAR>{{ cell.text }}</CHAR></TEXT>{% endif %}</P></PARALIST></CELL>{% endfor %}</ROW>{% endfor %}</TABLE>